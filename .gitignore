# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node
node_modules/
dist/

# Raw API payloads are large and fully regenerable via the ingest job.
backend/data/raw/

# Local env
.env
.env.*
!.env.example

# Editors / OS
.DS_Store
.idea/
.vscode/
*.tsbuildinfo

# The assignment brief itself is not part of the submission and would
# de-anonymise the repo.
*.docx

# Local credentials for deployment. Never commit.
.secrets.env

.vercel
.env*

# Keep the committed templates (the rule above would otherwise hide them).
!.env.example
!**/.env.example
